@startuml
skinparam ParticipantPadding 10
skinparam BoxPadding 10
skinparam linetype ortho

title Diagrama de Sequência: Estimativa Energética e Histórico

actor "Usuário" as user
participant "Tela Estimativa Energética" as tee
participant "grafico:ComponenteGrafico" as grafico
participant "Regiao" as regiao
participant "APIClima" as apiclima
participant "modulo:ModuloSolar" as modulo
participant "estimativa:EstimativaEnergetica" as estimativa
participant "historico:HistoricoGeracao" as historico

== 1. Consulta de Clima e Região ==
autonumber 1.1
user -> tee: Seleciona região
activate tee

tee -> regiao: buscar_dados(regiao.id)
activate regiao

regiao -> apiclima: buscar_dados_meteorologicos(regiao.coordenadas)
activate apiclima

apiclima --> regiao: dados_climaticos
deactivate apiclima

regiao --> tee: Regiao atualizada com historico_meteorologico
deactivate regiao

tee --> user: Retorna Região Selecionada

deactivate tee

== 2. Definição do Equipamento ==
autonumber 2.1
user -> tee: Informa dados do painel solar
activate tee

tee -> modulo ** : <<create>>
activate modulo
tee -> modulo: cadastrar_especificacoes(potencia, eficiencia, area, fabricante)
modulo --> tee: modulo_cadastrado
deactivate modulo

tee --> user: feedback de sucesso
deactivate tee

== 3. Cálculo da Estimativa e Renderização ==
autonumber 3.1
user -> tee: Solicita estimativa de produção
activate tee
tee -> estimativa ** : <<create>>
activate estimativa
tee -> estimativa: calcular_estimativa(regiao, modulo)
estimativa --> tee: dados_estimativa
deactivate estimativa

tee -> grafico ** : <<create>>
activate grafico
tee -> grafico: renderizar(dados_estimativa)
grafico --> tee: componente_visual
deactivate grafico

tee --> user: Exibe dashboard com a estimativa e o gráfico
deactivate tee

== 4. Salvamento no Histórico ==
autonumber 4.1
user -> tee: Seleciona "Salvar no Histórico"
activate tee
tee -> historico: salvar(estimativa)
activate historico

historico --> tee: status_salvamento
deactivate historico

tee --> user: feedback de sucesso

deactivate tee
@enduml