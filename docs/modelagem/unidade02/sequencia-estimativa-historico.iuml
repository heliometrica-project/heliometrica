@startuml
skinparam ParticipantPadding 10
skinparam BoxPadding 10
skinparam linetype ortho

title Diagrama de Sequência: Estimativa Energética e Histórico

actor "Usuário" as user
participant "TelaEstimativaEnergetica" as tela
participant "grafico:ComponenteGrafico" as grafico
participant ":Regiao" as regiao
participant ":APIClima" as apiclima
participant "modulo:ModuloSolar" as modulo
participant "estimativa:EstimativaEnergetica" as estimativa
participant "historico:HistoricoGeracao" as historico

== 1. Consulta de Clima e Região ==
autonumber 1.1
user -> tela: Seleciona região
activate tela

tela -> regiao: buscar_dados(regiao.id)
activate regiao

regiao -> apiclima: buscar_dados_meteorologicos(regiao.coordenadas)
activate apiclima

apiclima --> regiao: dados_climaticos
deactivate apiclima

regiao --> tela: Regiao updated com historico_meteorologico
deactivate regiao

tela --> user: Exibe dados climáticos da região
deactivate tela

== 2. Definição do Equipamento ==
autonumber 2.1
user -> tela: Informa dados do painel solar
activate tela

tela -> modulo ** : <<create>>
activate modulo
tela -> modulo: cadastrar_especificacoes(potencia, eficiencia, area, fabricante)
modulo --> tela: modulo_cadastrado
deactivate modulo

tela --> user: Confirma especificações do equipamento
deactivate tela

== 3. Cálculo da Estimativa e Renderização ==
autonumber 3.1
user -> tela: Solicita estimativa de produção
activate tela

tela -> estimativa ** : <<create>>
activate estimativa
tela -> estimativa: calcular_estimativa(regiao, modulo)
estimativa --> tela: dados_estimativa
deactivate estimativa

tela -> grafico ** : <<create>>
activate grafico
tela -> grafico: renderizar(dados_estimativa)
grafico --> tela: componente_visual
deactivate grafico

tela --> user: Exibe dashboard com a estimativa e o gráfico
deactivate tela

== 4. Salvamento no Histórico ==
autonumber 4.1
user -> tela: Seleciona "Salvar no Histórico"
activate tela

tela -> historico: salvar(estimativa)
activate historico

historico --> tela: status_salvamento
deactivate historico

tela --> user: Feedback de sucesso
deactivate tela
@enduml